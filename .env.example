# ─── Obrigatórias ────────────────────────────────────────────────────────

# PostgreSQL — string de conexão completa
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# JWT — segredo para assinar tokens de autenticação (mínimo 32 caracteres)
# NUNCA deixe em branco em produção — qualquer pessoa poderia forjar tokens
JWT_SECRET=sua-senha-super-secreta-para-tokens-minimo-32-chars

# Meta Graph API — token permanente com permissões ads_read + ads_management
META_ADS_TOKEN=EAAI...

# ─── Opcionais (recomendadas em produção) ────────────────────────────────

# Redis — cache de API e rate limiting. Se ausente, usa cache em memória
REDIS_URL=redis://redis:6379

# CORS — origens permitidas (separar por vírgula). Default: * (aceita tudo)
ALLOWED_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com

# Rate limit — requisições por minuto por usuário (default: 120)
RATE_LIMIT_RPM=120

# Tamanho maximo do JSON recebido nas APIs (default: 2MB)
MAX_BODY_BYTES=2097152

# Health detalhado em producao: prefira token em vez de endpoint publico
HEALTHCHECK_TOKEN=token_aleatorio_para_health_detalhado
# EXPOSE_DETAILED_HEALTH=true

# Cadastro publico: mantenha desligado em producao, salvo necessidade explicita
# ALLOW_PUBLIC_REGISTRATION=true
# ALLOW_PUBLIC_BOOTSTRAP=true
REGISTRATION_SECRET=segredo_para_bootstrap_admin

# Links compartilhados expiram por padrao em 30 dias
SHARE_TOKEN_DEFAULT_TTL_DAYS=30
# ALLOW_PERMANENT_SHARE_LINKS=true

# Compatibilidade legada: nao habilite em producao salvo migracao controlada
# ALLOW_UNSCOPED_CLIENT_ACCOUNTS=true
# WEBHOOK_SECRET_IN_URL=true

# Log level — debug | info | warn | error (default: info)
LOG_LEVEL=info

# Porta do servidor (default: 3000)
PORT=3000

# ─── Evolution API (WhatsApp) ────────────────────────────────────────────

# URL base da sua instância Evolution API
EVOLUTION_API_URL=https://sua-api.evolution.com

# Chave global de acesso da Evolution API
EVOLUTION_GLOBAL_KEY=sua_global_manager_key

# Segredo para validar webhooks recebidos da Evolution/N8N (obrigatorio em producao)
WEBHOOK_SECRET=segredo_para_validar_webhooks
