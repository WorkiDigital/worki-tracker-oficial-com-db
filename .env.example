DATABASE_URL=postgres://usuario:senha@ip:5432/banco
JWT_SECRET=sua-senha-super-secreta-para-tokens
META_ADS_TOKEN=your-meta-access-token
REDIS_URL=redis://redis:6379

# CORS: origens permitidas (separar por vírgula). Use * para permitir todas (dev only)
ALLOWED_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com

# Rate limit: requisições por minuto por usuário (default: 120)
RATE_LIMIT_RPM=120

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Configuracoes da Evolution API para Conexão Nativa de WhatsApp no SaaS
EVOLUTION_API_URL=https://sua-api.evolution.com
EVOLUTION_GLOBAL_KEY=sua_global_manager_key
