      "id": "93a04b27-9624-49bb-bab8-ae784eb0cb7a",
      "name": "BuscaRastreio + Pixel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        3200
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $input.first().json;\nconst norm = $('Normalizar [Lead]').first().json;\n\n// Extrai page_id de tracking_specs\nconst specs = Array.isArray(meta.tracking_specs) ? meta.tracking_specs : [];\nlet page_id = null;\nfor (const spec of specs) {\n  if (spec.page && spec.page.length > 0) {\n    page_id = String(spec.page[0]);\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    instance:              norm.instance,\n    evento:                'lead',\n    nome:                  norm.lead?.name || '',\n    telefone:              norm.lead?.celular || '',\n    mensagem_recebida:     norm.message?.content || '',\n    ctwaClid:              norm.anuncio?.ctawclid || '',\n    source_id:             norm.anuncio?.sourceId || '',\n    event_source_url:      norm.anuncio?.source_url || '',\n    anuncio_thumbnail_url: norm.anuncio?.thumbnail_url || '',\n    plataforma:            norm.anuncio?.plataforma || '',\n    utm_campaign:          meta.campaign?.name || null,\n    utm_medium:            meta.adset?.name   || null,\n    utm_content:           meta.name          || null,\n    page_id:               page_id\n  }\n}];"
      },
      "id": "5dfe7f3c-a02e-445e-ad4f-4dbf4173ae2e",
      "name": "Montar Payload Lead",
