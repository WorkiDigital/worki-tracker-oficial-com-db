      "id": "478817af-fc5b-46b1-b266-32aa4261d80b",
      "name": "Envia Lead \u2192 App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        3200
      ]
    },
    {
      "parameters": {
        "jsCode": "const wh = $('Webhook').item.json;\nconst data = wh.body.data;\nconst msg  = data.message?.conversation || data.message?.extendedTextMessage?.text || data.message?.imageMessage?.caption || '';\nconst telefone = (data.key.remoteJidAlt || data.key.remoteJid || '').split('@')[0];\nconst instance = wh.body.instance;\n\nconst get = (labels) => {\n  for (const label of labels) {\n    const re = new RegExp(`${label}[:\\\\s]+([^\\\\n]+)`, 'i');\n    const m  = msg.match(re);\n    if (m) return m[1].trim();\n  }\n  return null;\n};\n\nconst valorRaw = get(['valor', 'venda', 'total']) || '0';\nconst valor    = parseFloat(valorRaw.replace(/[^0-9,.]/g, '').replace(',', '.')) || 0;\n\nreturn [{\n  json: {\n    instance,\n    evento:      'purchase',\n    telefone,\n    nome:        get(['nome', 'cliente']),\n    valor_venda: valor,\n    cidade:      get(['cidade']),\n    estado:      get(['estado', 'uf'])\n  }\n}];"
      },
