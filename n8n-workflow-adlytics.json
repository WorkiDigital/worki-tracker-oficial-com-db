    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n-worki-tracker-oficial-2.ubufeb.easypanel.host/api/webhook-n8n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
